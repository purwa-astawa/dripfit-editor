# PostHog analytics (client-side, Vite exposes VITE_-prefixed vars to the browser).
# The project token is a public client key. Copy this file to `.env` and fill in.
VITE_POSTHOG_PROJECT_TOKEN=phc_your_public_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Shopify custom/Dev Dashboard app credentials — used ONLY locally to mint a
# public Storefront token via client-credentials (see the "get access token"
# workflow). NOT VITE_-prefixed, so they are never exposed to the browser bundle.
# The client secret is sensitive: keep it in `.env` (git-ignored), never commit it.
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_CLIENT_ID=your_app_client_id
SHOPIFY_CLIENT_SECRET=your_app_client_secret
SHOPIFY_API_VERSION=2025-01
